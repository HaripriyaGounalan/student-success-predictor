{
  "model_name": "StudentPersistenceNet",
  "version": "1.0.0",
  "n_features": 19,
  "feature_names": [
    "first_term_gpa",
    "second_term_gpa",
    "first_language",
    "fast_track",
    "coop",
    "residency",
    "gender",
    "prev_education",
    "age_group",
    "hs_avg",
    "math_score",
    "english_grade",
    "hs_avg_miss_flag",
    "funding_1",
    "funding_2",
    "funding_4",
    "funding_5",
    "funding_8",
    "program_completion"
  ],
  "binary_recode_cols": [
    "first_language",
    "fast_track",
    "coop",
    "residency",
    "gender",
    "prev_education"
  ],
  "scale_cols": [
    "first_term_gpa",
    "second_term_gpa",
    "age_group",
    "hs_avg",
    "math_score",
    "english_grade"
  ],
  "mode_impute_cols": [
    "gender",
    "prev_education",
    "age_group",
    "english_grade"
  ],
  "ohe_col": "funding",
  "knn_neighbors": 5,
  "default_threshold": 0.5,
  "tuned_threshold": 0.7,
  "target_col": "persistence",
  "class_labels": {
    "0": "Did not persist",
    "1": "Persisted"
  },
  "valid_ranges": {
